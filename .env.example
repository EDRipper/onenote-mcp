# Public HTTPS URL this server is reachable at (no trailing slash)
BASE_URL=https://onenote-mcp.example.com
PORT=3000

# From your Microsoft Entra app registration
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" = personal + work/school accounts. Use "consumers" for personal only, or a tenant ID for one org.
MS_TENANT=common
# Optional extra Graph scopes, e.g. Notes.ReadWrite.All for notebooks shared with you (needs admin consent on most school accounts)
MS_EXTRA_SCOPES=

# 32 random bytes, hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Postgres connection string. Without it, sign-ins are lost on restart.
DATABASE_URL=

# Chromium binary for rendering Mermaid diagrams (preset in the Docker image)
CHROMIUM_PATH=
